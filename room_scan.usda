#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {

    def Material "mat_chunk_A"
    {
        token outputs:surface.connect = </World/Looks/mat_chunk_A/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </World/Looks/mat_chunk_A/DiffuseTexture.outputs:rgb>
            float inputs:roughness = 0.7
            float inputs:metallic = 0.0
            token outputs:surface
        }

        def Shader "DiffuseTexture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/chunk_A_texture.jpeg@
            float2 inputs:st.connect = </World/Looks/mat_chunk_A/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "stReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

    def Material "mat_chunk_B_main"
    {
        token outputs:surface.connect = </World/Looks/mat_chunk_B_main/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </World/Looks/mat_chunk_B_main/DiffuseTexture.outputs:rgb>
            float inputs:roughness = 0.7
            float inputs:metallic = 0.0
            token outputs:surface
        }

        def Shader "DiffuseTexture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/chunk_B_main_texture.jpeg@
            float2 inputs:st.connect = </World/Looks/mat_chunk_B_main/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "stReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

    def Material "mat_chunk_C"
    {
        token outputs:surface.connect = </World/Looks/mat_chunk_C/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </World/Looks/mat_chunk_C/DiffuseTexture.outputs:rgb>
            float inputs:roughness = 0.7
            float inputs:metallic = 0.0
            token outputs:surface
        }

        def Shader "DiffuseTexture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/chunk_C_texture.jpeg@
            float2 inputs:st.connect = </World/Looks/mat_chunk_C/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "stReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

    }


